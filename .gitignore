out/
build/

# The Widget bundle, built into `public/` so the application serves it. Output,
# like the generated API types — but unlike those it is rebuilt by every build,
# so committing it would only be a copy going stale.
/public/widget/
next-env.d.ts
*.tsbuildinfo

# `.env.example` is the committed one, and it is a template rather than a value
# in force. A committed `.env` applies to every environment at once, which is
# the default `src/config/api.ts` deliberately refuses to have.
.env
.env.local
.env.*.local

.DS_Store
npm-debug.log*
coverage/
.vercel
